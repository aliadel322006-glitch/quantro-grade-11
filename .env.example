# Browser-safe Supabase values. Never put a service/secret key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only values used by Next.js route handlers.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
STUDENT_LOGIN_PEPPER=replace-with-at-least-32-random-bytes
# Required in production: random server-only secret for HMAC-hashed curriculum access codes.
ACCESS_CODE_PEPPER=replace-with-at-least-32-random-bytes
# Optional in local demo mode only. Do not use this demo session mechanism in production.
DEMO_SESSION_SECRET=replace-with-a-local-random-value
INTERNAL_STUDENT_EMAIL_DOMAIN=students.invalid
APP_ORIGIN=http://localhost:3000

# Operational defaults. The SQL migration enforces the hard security limits.
ASSET_SIGNED_URL_TTL_SECONDS=900
MAX_EVENT_SYNC_BATCH=100
LEARNER_DATA_RETENTION_DAYS=90

# Optional direct database URL for CI migrations only; do not expose to the app.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
